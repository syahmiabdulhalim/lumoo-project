# Copy this file to .env and fill in real values
# .env is gitignored — never commit real secrets

APP_BASE_URL=https://lumoo.my
RESEND_API_KEY=re_your_api_key_here
# AES-256 key: base64 of exactly 32 bytes. Generate with: openssl rand -base64 32
# Never change it once data exists — encrypted phone/address fields become unreadable.
ENCRYPTION_KEY=base64_32byte_key_here

# Password for the first admin account (admin@lumoo.my). Required in prod; no default.
# Generate one with: openssl rand -base64 18
ADMIN_PASSWORD=change_me_to_a_strong_password

# ModemPay — https://merchant.modempay.com → Developers → API Keys
MODEMPAY_API_KEY=sk_test_your_key_here
MODEMPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Cache — set to "simple" for local dev (no Redis needed), "redis" for Docker/production
SPRING_CACHE_TYPE=simple

# Redis — only needed when SPRING_CACHE_TYPE=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Database (docker compose) — required, no defaults
DB_USER=lumoo_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

# Redis password — required by docker compose
REDIS_PASSWORD=change_me
